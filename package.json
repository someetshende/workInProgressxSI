{
  "name": "oriel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oriel convenes the agents you already run and answers in one voice.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "seat": "tsx src/seats/local.ts",
    "stories": "tsx scripts/write-stories.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run stories && npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
